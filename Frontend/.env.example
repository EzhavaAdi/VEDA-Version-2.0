# =============================================================================
# VEDA V2 — Frontend Environment Variables Example
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER expose backend secrets here.
# Only VITE_* variables are available in the browser bundle.
# =============================================================================

# Backend API base URL — must match the Django development server address
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application name (used in page titles and metadata)
VITE_APP_NAME=VEDA

# Environment label (development | staging | production)
VITE_APP_ENV=development
