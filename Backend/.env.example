# =============================================================================
# VEDA V2 — Backend Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to Git.
# NEVER share credentials or secret keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# Generate a unique secret key for your local environment.
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-local-secret-key-here

# Set to True only during local development. Must be False in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts.
# Example: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------

# PostgreSQL connection settings for local development.
# Do not use production credentials here.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=veda_v2_dev
DB_USER=veda_user
DB_PASSWORD=your-local-db-password-here
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# OTP expiry duration in seconds (default: 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Maximum OTP verification attempts before lockout
OTP_MAX_ATTEMPTS=5

# OTP provider: CONSOLE (development only), SMS (production)
OTP_PROVIDER=CONSOLE

# JWT or session token settings (adjust to chosen auth library)
AUTH_TOKEN_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# AI Engine
# -----------------------------------------------------------------------------

# Absolute or relative path to the directory where trained model artifacts are stored.
# Do not store model artifacts inside the Git repository without explicit approval.
AI_MODEL_ARTIFACT_DIR=Backend/ai_engine/models

# Active APS model version identifier (must match a registered AIModel record)
APS_MODEL_VERSION=v1.0.0

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------

# Local media directory for uploaded files (vehicle photographs, documents, etc.)
MEDIA_ROOT=Backend/media

# URL prefix for serving media files during local development
MEDIA_URL=/media/

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------

# Payment provider: MOCK (local development), LIVE (production with real provider)
PAYMENT_PROVIDER=MOCK

# Mock payment secret (development only — replace with real credentials in production)
PAYMENT_MOCK_SECRET=mock-secret-key-not-for-production

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Frontend URL (for CORS and redirect links)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Notes
# =============================================================================
# 1. Never set DJANGO_DEBUG=True in a production deployment.
# 2. Never use OTP_PROVIDER=CONSOLE in production — this bypasses real OTP delivery.
# 3. The DB_NAME 'veda_v2_dev' must exist in your local PostgreSQL instance.
#    Create it with: CREATE DATABASE veda_v2_dev;
#    Create the user with: CREATE USER veda_user WITH PASSWORD 'your-password';
#    Grant access with: GRANT ALL PRIVILEGES ON DATABASE veda_v2_dev TO veda_user;
# 4. AI_MODEL_ARTIFACT_DIR should point to a location outside the Git-tracked tree
#    if model files are large or proprietary.
# =============================================================================
